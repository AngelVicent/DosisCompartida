# Copia este archivo a .env y ajusta los valores.
PORT=3000
DATABASE_URL=postgres://dosis:dosis@localhost:5432/dosiscompartida
# Zona horaria con la que se calcula "hoy" y las horas de las dosis
TZ_APP=America/Mexico_City
# Obligatorio: una cadena larga y aleatoria (mínimo 16 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
UPLOADS_DIR=uploads
